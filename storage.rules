rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lost and found item photos
    // Anyone can read photos so items can be visually identified.
    // Uploads must be authenticated, restricted to the user's directory, and <= 2 MB JPG/PNG/WEBP.
    match /item-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
