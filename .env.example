# ------------------------------------------------------------------
# FindBack Environment Variables (.env)
# ------------------------------------------------------------------
# 1. Copy this file and rename the copy to ".env"
# 2. Paste your Firebase keys below
# 3. Run:  npm run check:firebase
# 4. Restart "npm run dev"
#
# Leave these empty to run in DEMO MODE (sample data saved in browser only).
# ------------------------------------------------------------------

# ==================================================================
# 1. FIREBASE CONFIGURATION (Web App)
# Where to find these:
#   1. Go to Firebase Console (https://console.firebase.google.com/)
#   2. Project Settings -> General -> "Your apps" -> Web app (</>)
#   3. Copy the values from firebaseConfig:
# ==================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ==================================================================
# 2. OPTIONAL PYTHON MATCHING BACKEND (backend/)
# Start with:  npm run api
# Leave empty to use the in-browser engine (same algorithm & scores).
# ==================================================================
VITE_MATCHING_API_URL=

# Optional backend credentials for Firebase Admin SDK:
# Keep serviceAccountKey.json ONLY inside backend/ or a private folder.
# NEVER put service account private keys in any VITE_ variable!
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# ==================================================================
# 3. SUPABASE (Legacy / Alternative backend)
# ==================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
