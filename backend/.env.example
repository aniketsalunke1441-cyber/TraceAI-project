# ------------------------------------------------------------------
# FindBack Python API settings (copy to backend/.env if you need them).
# Usually NOT needed: if these are empty, the API reads Firebase or Supabase
# configuration from the project's root .env file automatically.
# ------------------------------------------------------------------
# Firebase Admin settings:
FIREBASE_PROJECT_ID=
# Optional path to serviceAccountKey.json (downloaded from Firebase Console -> Project Settings -> Service accounts)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# Supabase settings (alternative):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Allowed frontend origins for CORS (comma-separated, no "*")
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
